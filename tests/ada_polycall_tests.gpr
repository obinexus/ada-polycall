with "../ada_polycall.gpr";

project Ada_Polycall_Tests is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "../build/tests";
   for Exec_Dir use "../build";
   for Main use ("ada_polycall_test.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnatwa", "-g");
   end Compiler;
end Ada_Polycall_Tests;
